# Managed by LESta. Do not edit by hand.
# resource={{.ResourceID}} (webmail: this node's own mail hostname)
server {
    listen {{.IPAddress}}:{{.Port}};
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};
    access_log {{.AccessLogPath}};

    location /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{.IPAddress}}:{{.SSLPort}} ssl;
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};
    access_log {{.AccessLogPath}};

    ssl_certificate {{.CertificatePath}};
    ssl_certificate_key {{.PrivateKeyPath}};

    root /var/www/lesta-webmail/public_html;
    index index.php;
    client_max_body_size 25m;

    # ^~, not a plain prefix: the `~ /\.` deny below is a regex location,
    # and nginx checks regex locations after the longest plain prefix match,
    # so without ^~ it would win and break ACME renewal for this domain.
    location ^~ /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;
    }

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # \.php(/|$), not \.php$: Roundcube 1.7 serves every skin/plugin/js
    # asset through public_html/static.php/<path> (rcmail_output_html's
    # resource_location()), and a plain \.php$ never matches those URIs, so
    # they fell through to index.php and every asset came back as HTML.
    # try_files resets $fastcgi_path_info, hence the copy into $path_info.
    location ~ \.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        set $path_info $fastcgi_path_info;
        try_files $fastcgi_script_name =404;
        fastcgi_pass unix:{{.WebmailSocket}};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        include {{.FastcgiParamsPath}};
    }

    location ~ /\. {
        deny all;
    }
}
