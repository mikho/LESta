# Managed by LESta. Do not edit by hand.
# resource={{.ResourceID}}
server {
    listen {{.IPAddress}}:{{.Port}};
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};
    access_log {{.AccessLogPath}};
    error_log {{.ErrorLogPath}} warn;
{{template "waf" .}}
{{template "ipAccess" .}}
{{template "redirects" .}}

    location ^~ /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;{{if .IpRestricted}}
        allow all;{{end}}
    }

    root {{.Docroot}};
    index index.html index.htm;

    location = /__lesta-health__ {
        {{if .IpRestricted}}allow all;{{end}}
        default_type text/plain;
        return 200 '{{.Marker}}
';
    }

    location / {
        try_files $uri $uri/index.html $uri/index.htm =404;
    }

{{template "errorPages" .}}
{{template "hotlink" .}}
    location ~ /\.ht {
        deny all;
    }
}
