# Managed by LESta. Do not edit by hand.
# resource={{.ResourceID}}
server {
    listen {{.IPAddress}}:{{.Port}};
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};
    access_log {{.AccessLogPath}};

    location /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;
    }

    root {{.Docroot}};
    index index.html index.htm;

    location = /__lesta-health__ {
        default_type text/plain;
        return 200 '{{.Marker}}
';
    }

    location / {
        try_files $uri $uri/ =404;
    }

{{template "errorPages" .}}
    location ~ /\.ht {
        deny all;
    }
}
