server {
    listen {{.IPAddress}}:{{.Port}};
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};

    location /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;
    }

    location / {
        default_type text/plain;
        return 200 '{{.Marker}}
';
    }
}
