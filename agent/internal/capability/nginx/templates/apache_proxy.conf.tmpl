# Managed by LESta. Do not edit by hand.
# resource={{.ResourceID}} (proxied to Apache backend {{.ProxyBackend}})
server {
    listen {{.IPAddress}}:{{.Port}};
    server_name {{.Domain}}{{range .Aliases}} {{.}}{{end}};
    access_log {{.AccessLogPath}};
{{template "waf" .}}
{{template "ipAccess" .}}
{{template "redirects" .}}

    location ^~ /.well-known/acme-challenge/ {
        alias {{.AcmeChallengeDir}}/;{{if .IpRestricted}}
        allow all;{{end}}
    }

    location / {
        proxy_pass http://{{.ProxyBackend}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
