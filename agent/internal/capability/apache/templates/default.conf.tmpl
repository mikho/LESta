# resource={{.ResourceID}}
<VirtualHost {{.IPAddress}}:{{.Port}}>
    ServerName {{.Domain}}
{{if .Aliases}}    ServerAlias{{range .Aliases}} {{.}}{{end}}
{{end}}    Alias /.well-known/acme-challenge/ "{{.AcmeChallengeDir}}/"
    <Directory "{{.AcmeChallengeDir}}">
        Require all granted
    </Directory>
    DocumentRoot "{{.ContentDir}}"
    <Directory "{{.ContentDir}}">
        Require all granted
        Options None
        AllowOverride None
        DirectoryIndex content
        SetHandler send-as-is
    </Directory>
</VirtualHost>
